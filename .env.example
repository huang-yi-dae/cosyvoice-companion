# ============================================================
# Local secrets & active-user selection (COPY to .env and fill in)
# .env is gitignored — never commit real values.
# ============================================================

# The QQ number of the user currently being analyzed / cloned.
# Determines which private/users/<qq>/ subtree the tools operate on.
ACTIVE_QQ=

# SQLCipher key (hex) used to decrypt the NTQQ message database.
# Extract with internal/src/tools/windows_ntqq_get_key.ps1.
SQLCIPHER_KEY=

# Optional display names used in reports/analysis output.
USER_NAME=
PARTNER_NAME=

# Aliyun Bailian (DashScope) API key for the cloud TTS provider.
# Get one at https://help.aliyun.com/zh/model-studio/get-api-key
# Leave empty to use only the local CosyVoice engine.
DASHSCOPE_API_KEY=

# Optional web access token. When set, the web UI requires this token
# (via ?token=, Authorization: Bearer, or cookie). REQUIRED if you expose the
# server beyond localhost (web.host = 0.0.0.0). Leave empty for localhost-only use.
WEB_AUTH_TOKEN=
